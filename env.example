# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key (solo para scripts de servidor, NUNCA exponer en el cliente)
# Dashboard > Project Settings > API > service_role secret
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: Supabase Project ID (requerido si usas URL personalizada, ej: api.tudominio.com)
# Si tu URL es *.supabase.co, se extrae automáticamente
# SUPABASE_PROJECT_ID=your_project_id

# Optional: Supabase Access Token (para generar tipos automáticamente)
# Obtén tu token desde: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=your_access_token

# Application Configuration
VITE_APP_NAME=Ecommerce App
VITE_APP_URL=http://localhost:5173

# URL del frontend (confirmación de email, magic links, etc.). Si no se define, se usa VITE_APP_URL u origin.
VITE_APP_URL=http://localhost:5173
